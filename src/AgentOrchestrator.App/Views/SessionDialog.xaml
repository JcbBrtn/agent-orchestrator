<Window x:Class="AgentOrchestrator.App.Views.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New session" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="12">
        <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseFolder" Margin="4,0,0,0" Padding="10,0" />
            <TextBox x:Name="FolderBox" TextChanged="OnFolderChanged" />
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Text="Agents start here: relative paths and PowerShell commands resolve against this folder." />

        <TextBlock Text="Orchestration" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseGraph" Margin="4,0,0,0" Padding="10,0" />
            <ComboBox x:Name="GraphCombo" DisplayMemberPath="Display" />
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Text="The agent graph this session runs. Saved graphs live in the graphs folder; you can also pick any .json graph file." />

        <TextBlock Text="Session name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Create" IsDefault="True" Click="OnOk" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
