<Window x:Class="AgentOrchestrator.App.Views.RunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run graph" Width="640" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="▶ Run" IsDefault="True" Click="OnRun" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Entry agent" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
            <ComboBox x:Name="EntryCombo" DisplayMemberPath="Name" />
            <TextBlock x:Name="WorkDirLabel" Text="Working directory (default for relative paths and PowerShell)" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Click="OnBrowse" Margin="4,0,0,0" Padding="8,0" />
                <TextBox x:Name="WorkDirBox" />
            </DockPanel>
            <TextBlock Text="Task" Style="{StaticResource FieldLabel}" />
        </StackPanel>
        <TextBox x:Name="TaskBox" Style="{StaticResource MultiLine}" />
    </DockPanel>
</Window>
