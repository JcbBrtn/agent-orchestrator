<Window x:Class="AgentOrchestrator.App.Views.OrchestrationSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/xaml/metadata/xaml-metadata-definitions"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Orchestration" Height="520" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select an orchestration to add to the current one:" 
                   Margin="20,20,20,10" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />

        <ListBox x:Name="OrchestrationListBox" Grid.Row="1" Margin="20,0,20,10" DisplayMemberPath="Name"
                 SelectionChanged="OnOrchestrationChanged" AutomationProperties.Name="Orchestrations to add"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="2" Text="Entry point (primary hook):" Margin="20,0,20,4" />
        <ComboBox x:Name="HookComboBox" Grid.Row="3" Margin="20,0,20,10" DisplayMemberPath="Name"
                  AutomationProperties.Name="Primary hook" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
            <Button Content="Cancel" Click="OnCancel" Width="100" Margin="10,0" IsCancel="True" />
            <Button Content="Add" Click="OnSelect" Width="100" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>