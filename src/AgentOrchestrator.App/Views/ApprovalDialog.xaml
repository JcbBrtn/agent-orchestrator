<Window x:Class="AgentOrchestrator.App.Views.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve tool call?" Width="720" Height="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="RiskText" DockPanel.Dock="Top" Foreground="DarkOrange" FontWeight="SemiBold" Margin="0,4,0,0"
                   Text="⚠ This call is classified as risky." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Approve" IsDefault="True" Click="OnApprove" Style="{StaticResource DialogButton}" />
            <Button x:Name="ApproveAllButton" Content="Approve all for this run" Click="OnApproveAll" Style="{StaticResource DialogButton}" />
            <Button Content="_Deny" IsCancel="True" Click="OnDeny" Style="{StaticResource DialogButton}" />
        </StackPanel>
        <TextBox x:Name="ArgsBox" Style="{StaticResource MultiLine}" IsReadOnly="True" Margin="0,8,0,0"
                 HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
