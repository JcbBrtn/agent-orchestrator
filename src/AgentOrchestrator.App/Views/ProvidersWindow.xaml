<Window x:Class="AgentOrchestrator.App.Views.ProvidersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model providers" Width="820" Height="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="＋ Add" Click="OnAdd" Padding="10,3" />
                <Button Content="Remove" Click="OnRemove" Padding="10,3" Margin="6,0,0,0" />
            </StackPanel>
            <ListBox x:Name="ProviderList" DisplayMemberPath="Name" SelectionChanged="OnSelectionChanged" />
        </DockPanel>
        <DockPanel Grid.Column="2" x:Name="EditorPanel" IsEnabled="False">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Test (list models)" Click="OnTest" Style="{StaticResource DialogButton}" />
                <Button Content="Save" Click="OnSave" Style="{StaticResource DialogButton}" IsDefault="True" />
                <Button Content="Close" IsCancel="True" Style="{StaticResource DialogButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                <TextBox x:Name="NameBox" />
                <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="KindCombo" SelectionChanged="OnKindChanged" />
                <TextBlock Text="Endpoint (OpenAI-compatible base URL)" Style="{StaticResource FieldLabel}" x:Name="EndpointLabel" />
                <TextBox x:Name="EndpointBox" />
                <TextBlock Text="API key / personal access token" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="KeyBox" />
                <TextBlock x:Name="KeyHint" Style="{StaticResource Hint}" />
                <TextBlock x:Name="KindHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Keys are encrypted with Windows DPAPI for your user account." />
                <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
