<Window x:Class="AgentOrchestrator.App.Views.SkillsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skills" Width="980" Height="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="＋ New" Click="OnNew" Padding="10,3" />
                <Button Content="Delete" Click="OnDelete" Padding="10,3" Margin="6,0,0,0" />
                <Button Content="Open folder" Click="OnOpenFolder" Padding="10,3" Margin="6,0,0,0" />
            </StackPanel>
            <ListBox x:Name="SkillList" DisplayMemberPath="Name" SelectionChanged="OnSelectionChanged" />
        </DockPanel>
        <DockPanel Grid.Column="2" x:Name="EditorPanel" IsEnabled="False">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                <TextBox x:Name="NameBox" />
                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DescriptionBox" />
                <TextBlock Text="Instructions (markdown, injected into the agent's system prompt)" Style="{StaticResource FieldLabel}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock x:Name="FileText" Foreground="{DynamicResource HintForeground}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Save" Click="OnSave" Style="{StaticResource DialogButton}" IsDefault="True" />
            </StackPanel>
            <TextBox x:Name="ContentBox" Style="{StaticResource MultiLine}" />
        </DockPanel>
    </Grid>
</Window>
